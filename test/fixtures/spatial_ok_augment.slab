<shaderlab version="2.0">
  <shader_frame id="bg" type="canvas_item">
    <fragment><![CDATA[COLOR = vec4(UV, 0.0, 1.0);]]></fragment>
  </shader_frame>
  <shader_frame id="space" type="spatial" mode="augment">
    <fragment><![CDATA[COLOR = texture(CANVAS_TEXTURE, CANVAS_UV);]]></fragment>
  </shader_frame>
</shaderlab>
